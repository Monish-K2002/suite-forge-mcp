# ====================================================================
# Suite Forge MCP - Environment Configuration Template
# Copy this file to .env before deploying:
#   cp .env.example .env
# ====================================================================

# Application Environment: 'development' or 'production'
APP_ENV=production

# 32+ character key for AES encryption of NetSuite secrets and API keys stored in SQLite
ENCRYPTION_KEY=replace_this_with_a_secure_32_character_key_12345

# Allowed CORS origins for the FastAPI server (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost

# API Endpoint used by the browser to communicate with the FastAPI backend
VITE_NETSUITE_API_ENDPOINT=http://localhost:8000

